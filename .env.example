# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is ignored by git.

# --- Supabase (London / eu-west-2 project) ---
# Found in Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public "anon"/publishable key — safe in the browser because RLS protects every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random secret used to hash IP addresses for rate limiting / audit (generate: openssl rand -hex 32)
IP_HASH_SECRET=

# --- Email (Resend, Phase 5) ---
RESEND_API_KEY=
EMAIL_FROM="AbsorbHR Portal <no-reply@your-domain.co.uk>"
# Shared secret for /api/cron/dispatch (sends email, deletes queued files/accounts). At least 32 characters.
# Generate: openssl rand -hex 32. The same value goes in Supabase Vault as 'cron_secret'.
CRON_SECRET=

# --- Database tooling (scripts/db.mjs: migrations, seed, security tests) ---
# Supabase → avatar (top right) → Account preferences → Access Tokens. Developer use only.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
